# PostgreSQL connection (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pos_assistant?schema=public"

# HTTP server (optional, default 3000)
PORT=3000

# --- Chat API ---
# Optional: require X-API-Key header matching this value on /chat
# CHAT_API_KEY=

# Rate limiting for /chat (optional)
# CHAT_RATE_LIMIT_WINDOW_MS=900000
# CHAT_RATE_LIMIT_MAX=60

# direct = repository queries in-process; mcp = dispatch via MCP stdio client
CHAT_EXECUTION_MODE=direct

# --- Intent interpretation ---
# LLM structured outputs are required for intent interpretation.
# (USE_LLM is no longer used.)

# --- OpenAI (required for chat intent interpretation; also used by NL-SQL / MCP helpers) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.2

# Second LLM call: natural-language reply grounded ONLY in query results (structured output).
# Set false to use deterministic templates (and optional MCP tool reply strings) instead.
USE_LLM_REPLY=true
# OPENAI_REPLY_TEMPERATURE=0.35

# --- MCP client (when CHAT_EXECUTION_MODE=mcp) ---
# MCP_CLIENT_COMMAND=npm
# MCP_CLIENT_ARGS=run mcp:dev
# MCP_CLIENT_CWD=
