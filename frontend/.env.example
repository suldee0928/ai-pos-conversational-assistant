# Vite only exposes vars prefixed with VITE_. Copy to .env.local or .env and adjust.

# Backend origin for /chat and related calls (omit to use built-in dev default http://localhost:3000)
# VITE_API_BASE_URL=http://localhost:3000

# If the backend enables CHAT_API_KEY, paste the shared key here; sent as X-API-Key
# VITE_CHAT_API_KEY=

# UI hint only: badge for “MCP connected” styling (true or false). Does not toggle server behaviour.
# VITE_MCP_CONNECTED=false
